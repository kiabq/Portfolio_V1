---
import IndexLayout from "../layouts/IndexLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { TRANSITION, titleSlide, customTransition } from "../lib";

import { getCollection } from "astro:content";
const posts = await getCollection("writings");
---

<IndexLayout>
  <Header />
  <div
    data-observe
    class={`flex flex-col py-4 ${TRANSITION.join(" ")}`}
    id="body"
  >
    <div class="flex flex-col gap-4 tracking-[0.01em]">
      <p>I'm Joseph, an associate software engineer at Signal Mine.</p>
      <p>
        I spend most of my time in Go and TypeScript, and I'm drawn to
        understanding how things work.
      </p>
      <p>
        When I'm not at a desk, I'm out climbing, riding my motorcycle, or in a
        book.
      </p>
    </div>
    <div class="flex">
      <div>
        <h2>PROJECTS</h2>
      </div>
      <div>
        <h2>WRITINGS</h2>
        {
          posts.map((post) => (
            <a
              href={`/writings/${post.id}`}
              transition:name={`link-${post.id}`}
              transition:animate={customTransition(titleSlide)}
            >
              {post.data.title}
            </a>
          ))
        }
      </div>
    </div>
  </div>
  <Footer />
</IndexLayout>
