---
import IndexLayout from "../layouts/IndexLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { TRANSITION } from "../lib";

import { getCollection } from "astro:content";
const posts = await getCollection("writings");

import projects from "../data/projects.json";
---

<IndexLayout>
  <Header />
  <div
    data-observe
    class={`flex flex-col py-4 ${TRANSITION.join(" ")}`}
    id="body"
  >
    <div class="flex flex-col gap-4 tracking-[0.01em]">
      <p>I'm Joseph, an associate software engineer at Signal Mine.</p>
      <p>
        I spend most of my time in Go and TypeScript, and I'm drawn to
        understanding how things work.
      </p>
      <p>
        When I'm not at a desk, I'm out climbing, riding my motorcycle, or in a
        book.
      </p>
    </div>
    <div
      class={`
        flex flex-col gap-4 py-8 tracking-[0.01em]
        md:flex-row
    `}
    >
      <div
        class={`
            flex flex-1 flex-col gap-1
            md:flex-3/5
      `}
      >
        <h2 class="pb-2">Projects</h2>
        {projects.map((project) => <p>{project.name}</p>)}
      </div>
      <div
        class={`
            flex flex-1 flex-col gap-1
            md:flex-2/5
      `}
      >
        <h2 class="pb-2">Writings</h2>
        {
          posts.map((post) => (
            <a href={`/writings/${post.id}`} class="hover:underline">
              <span class="flex-2 flex-nowrap">{post.data.title}</span>
            </a>
          ))
        }
      </div>
    </div>
  </div>
  <Footer />
</IndexLayout>
